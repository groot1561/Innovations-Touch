---
---

<section id="home" class="min-h-screen flex items-center relative overflow-hidden bg-charcoal section-padding py-24 lg:py-0">
  <!-- Main Background Image: Architectural Luxury Interior -->
  <div class="hero-image-wrapper absolute inset-0 w-full h-full will-change-transform" style="transform: scale(1.05); opacity: 0;">
    <img 
      src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?w=1920&q=80&auto=format&fit=crop" 
      alt="Luxury architectural residential remodeling and renovation interior space" 
      class="hero-image absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Sophisticated multi-stage dark overlay for maximum contrast -->
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal/90 via-charcoal/75 to-charcoal/50"></div>
    <div class="absolute inset-0 bg-charcoal/30"></div>
  </div>

  <!-- Content Container: Floating Architectural Glassmorphic Hero Card with Embedded Photo -->
  <div class="relative z-10 w-full max-w-6xl mx-auto">
    <div class="hero-content hero-card bg-charcoal/60 backdrop-blur-md p-8 sm:p-10 lg:p-14 rounded-3xl border border-ivory/20 shadow-2xl relative overflow-hidden">
      
      <!-- Card Architectural Ambient Lighting -->
      <div class="absolute -top-24 -right-24 w-48 h-48 bg-sage/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Text & Details Column (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <!-- Top Badge -->
          <div class="hero-label opacity-0 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono tracking-widest text-cream bg-sage/20 backdrop-blur-md border border-sage/40">
            <span class="w-2 h-2 rounded-full bg-sage animate-pulse"></span>
            RESIDENTIAL REMODELING & DESIGN
          </div>
          
          <!-- Headline -->
          <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-ivory leading-[1.1] tracking-tight">
            <span class="hero-heading-line block opacity-0">Spaces Designed</span>
            <span class="hero-heading-line block opacity-0 text-cream">Around The Way You Live.</span>
          </h1>
          
          <!-- Subtitle -->
          <p class="hero-text opacity-0 text-cream-light/90 text-sm sm:text-base lg:text-lg leading-relaxed font-sans font-light">
            Thoughtful remodeling, refined design, and careful craftsmanship that brings your architectural vision home.
          </p>
          
          <!-- CTA Buttons -->
          <div class="hero-ctas opacity-0 flex flex-wrap gap-4 pt-2">
            <a 
              href="#contact" 
              class="bg-olive text-ivory px-8 py-4 text-xs sm:text-sm uppercase tracking-[0.2em] font-bold font-sans rounded-xl hover:bg-olive-deep hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300"
            >
              Start Your Project
            </a>
            <a 
              href="#portfolio" 
              class="border border-ivory/30 text-ivory px-8 py-4 text-xs sm:text-sm uppercase tracking-[0.2em] font-bold font-sans rounded-xl hover:bg-ivory/10 hover:border-ivory/60 transition-all duration-300"
            >
              View Our Work
            </a>
          </div>
        </div>

        <!-- Embedded Photo Showcase Column Inside Home Card (5 cols) -->
        <div class="lg:col-span-5 hero-card-photo-wrapper relative rounded-2xl overflow-hidden border border-ivory/20 shadow-xl group aspect-[4/3] lg:aspect-[4/5] bg-charcoal-light/30">
          <img 
            src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=800&q=80&auto=format&fit=crop" 
            alt="Featured Luxury Residential Kitchen Remodel Showcase" 
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          <!-- Subtle Inner Vignette & Caption Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-ivory">
            <span class="text-[11px] font-mono tracking-widest uppercase text-cream/90 bg-charcoal/60 backdrop-blur-md px-3 py-1 rounded-full border border-ivory/20">
              Luxury Remodel
            </span>
            <span class="text-[10px] uppercase tracking-widest text-sage font-sans font-semibold">
              Dallas, TX
            </span>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="hero-scroll-indicator hidden md:flex absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-2 text-ivory/60 opacity-0 z-20">
    <span class="text-[10px] uppercase tracking-[0.25em] font-sans font-medium">Scroll</span>
    <div class="w-[1px] h-10 bg-ivory/30 overflow-hidden relative">
      <div class="absolute top-0 left-0 w-full bg-ivory/80 animate-scroll-line" style="height: 100%;"></div>
    </div>
  </div>
</section>

<style>
  @keyframes scrollLine {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(0); }
    100% { transform: translateY(100%); }
  }
  .animate-scroll-line {
    animation: scrollLine 2s ease-in-out infinite;
  }
</style>
